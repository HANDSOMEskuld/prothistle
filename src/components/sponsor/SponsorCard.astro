---
import { Icon } from "astro-icon/components";
import { sponsorConfig } from "@/config";
import { url } from "@/utils/url-utils";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const enabledMethods = sponsorConfig.methods.filter((method) => method.enabled);
const showTitle = true;
const compactMode = false;
---

{enabledMethods.length > 0 && (
  <div class={`sponsor-card ${compactMode ? 'compact' : ''}`}>
    {showTitle && (
      <div class="flex items-center gap-3 mb-6">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon name="material-symbols:favorite" class="text-[1.5rem]"></Icon>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
          赞赏支持
        </h3>
      </div>
    )}
    
    {sponsorConfig.usage && (
      <div class="mb-6 p-4 rounded-lg bg-(--primary)/8 dark:bg-(--btn-regular-bg) border border-(--primary)/30 dark:border-none backdrop-blur-xs shadow-xs">
        <div class="flex items-start gap-2">
          <Icon name="material-symbols:info-outline" class="text-(--primary) text-lg shrink-0 mt-0.5" />
          <p class="text-sm text-neutral-700 dark:text-neutral-200 leading-relaxed">
            {sponsorConfig.usage}
          </p>
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {enabledMethods.map((method) => (
        <div class="flex flex-col items-center card-base p-4 rounded-lg bg-neutral-50 dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 hover:border-(--primary) transition-colors">
          <!-- 图标和名称 -->
          <div class="flex items-center gap-3 mb-3">
            {method.icon && (
              <Icon name={method.icon} class="text-xl text-neutral-900 dark:text-neutral-100 transition-colors" />
            )}
            <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
              {method.name}
            </h4>
          </div>

          <!-- 描述 -->
          {method.description && (
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-3 text-center">
              {method.description}
            </p>
          )}

          <!-- 二维码或链接 -->
          {method.qrCode && (
            <div class="relative w-full max-w-[150px] aspect-square bg-white rounded-lg p-3 shadow-md mb-3">
              <img
                src={url(method.qrCode)}
                alt={`${method.name} ${i18n(I18nKey.scanToSponsor)}`}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
          )}

          {method.link && (
            <a
              href={method.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/90 active:scale-95 transition-all text-sm"
            >
              <span>{i18n(I18nKey.sponsorGoTo)}</span>
              <Icon name="fa7-solid:arrow-up-right-from-square" class="text-xs" />
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .sponsor-card {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line-divider);
  }
  
  .sponsor-card.compact {
    margin-top: 1rem;
    padding-top: 1rem;
  }
  
  /* 透明模式下使用半透明背景 */
  :global(body.wallpaper-transparent .sponsor-card .usage-info-box) {
    background-color: rgba(var(--primary-rgb, 70, 130, 180), 0.15) !important;
  }

  :global(:root.dark body.wallpaper-transparent .sponsor-card .usage-info-box) {
    background-color: oklch(from var(--primary) l c h / 0.15) !important;
  }
</style>
